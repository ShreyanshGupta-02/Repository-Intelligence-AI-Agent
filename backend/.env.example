# ============================================================
# Repository Intelligence AI Agent — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is git-ignored and will NOT be committed.
# ============================================================

# Neon PostgreSQL connection
# IMPORTANT: Must use JDBC format (jdbc:postgresql://...), NOT Neon's native format (postgresql://...)
# Do NOT embed username:password in the URL — use separate variables below.
DATABASE_URL=jdbc:postgresql://<your-neon-hostname>/<your-database-name>?sslmode=require
DATABASE_USERNAME=<your-neon-username>
DATABASE_PASSWORD=<your-neon-password>

# Groq API key (used for chat/completions only, NOT for embeddings)
GROQ_API_KEY=gsk_your_groq_api_key_here

# JWT Secret (generate with: openssl rand -base64 32) — used in Phase 12
# JWT_SECRET=your_jwt_secret_here
